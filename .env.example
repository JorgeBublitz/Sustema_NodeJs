# Servidor
PORT=3000
NODE_ENV=development

# CORS — separe múltiplas origens com vírgula (usado apenas em produção)
CORS_ORIGIN=http://localhost:3000

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/sustema?schema=public"

# Autenticação JWT
# JWT_SECRET é obrigatório — gere um valor forte, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=8h
